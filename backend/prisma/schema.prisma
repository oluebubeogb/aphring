generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum KnowledgeType {
  history
  politics
  traditional
  education
  culture
  government
  person
  event
}

enum KnowledgeStatus {
  DRAFT
  PENDING
  VERIFIED
  REJECTED
}

enum EntityType {
  PERSON
  LOCATION
  TITLE
  ORGANIZATION
  EVENT
  OTHER
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  avatar    String?
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  knowledgeRecords KnowledgeRecord[] @relation("CreatedBy")
  verifiedRecords  KnowledgeRecord[] @relation("VerifiedBy")
  documents        Document[]
  chats            Chat[]

  @@map("users")
}

model Community {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  lga       String?
  state     String   @default("Abia")
  country   String   @default("Nigeria")
  description String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  knowledgeRecords KnowledgeRecord[]

  @@map("communities")
}

model KnowledgeRecord {
  id          String          @id @default(cuid())
  title       String
  content     String
  type        KnowledgeType
  status      KnowledgeStatus @default(DRAFT)
  embedding   Unsupported("vector(1536)")?
  createdById String          @map("created_by")
  verifiedById String?        @map("verified_by")
  communityId String?         @map("community_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  createdBy  User       @relation("CreatedBy", fields: [createdById], references: [id])
  verifiedBy User?      @relation("VerifiedBy", fields: [verifiedById], references: [id])
  community  Community? @relation(fields: [communityId], references: [id])
  citations  Citation[]
  entities   KnowledgeEntity[]

  @@index([status])
  @@index([type])
  @@index([communityId])
  @@map("knowledge_records")
}

model Entity {
  id          String     @id @default(cuid())
  name        String
  entityType  EntityType @map("entity_type")
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  knowledgeLinks KnowledgeEntity[]

  @@index([name])
  @@map("entities")
}

model KnowledgeEntity {
  id                String @id @default(cuid())
  knowledgeRecordId String @map("knowledge_record_id")
  entityId          String @map("entity_id")

  knowledgeRecord KnowledgeRecord @relation(fields: [knowledgeRecordId], references: [id], onDelete: Cascade)
  entity          Entity          @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([knowledgeRecordId, entityId])
  @@map("knowledge_entities")
}

model Document {
  id         String   @id @default(cuid())
  filename   String
  path       String
  mimeType   String   @map("mime_type")
  size       Int
  uploadedById String @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  uploadedBy User       @relation(fields: [uploadedById], references: [id])
  citations  Citation[]

  @@map("documents")
}

model Citation {
  id                String  @id @default(cuid())
  knowledgeRecordId String  @map("knowledge_record_id")
  documentId        String  @map("document_id")
  page              Int?
  paragraph         String?

  knowledgeRecord KnowledgeRecord @relation(fields: [knowledgeRecordId], references: [id], onDelete: Cascade)
  document        Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("citations")
}

model Chat {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String   @default("New Chat")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@map("chats")
}

model Message {
  id        String      @id @default(cuid())
  chatId    String      @map("chat_id")
  role      MessageRole
  content   String
  createdAt DateTime    @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@map("messages")
}
