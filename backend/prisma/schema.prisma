generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum KnowledgeType {
  history
  politics
  traditional
  education
  culture
  government
  person
  event
}

enum KnowledgeStatus {
  DRAFT
  PENDING
  VERIFIED
  REJECTED
}

enum EntityType {
  PERSON
  LOCATION
  TITLE
  ORGANIZATION
  EVENT
  OTHER
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum VoteType {
  UP
  DOWN
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  avatar    String?
  role      Role     @default(USER)
  reputation Int     @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  knowledgeRecords KnowledgeRecord[] @relation("CreatedBy")
  verifiedRecords  KnowledgeRecord[] @relation("VerifiedBy")
  documents        Document[]
  chats            Chat[]
  votes            Vote[]
  reports          Report[]
  audioUploads     AudioUpload[]

  @@map("users")
}

model Community {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  lga         String?
  ward        String?
  state       String   @default("Abia")
  country     String   @default("Nigeria")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  knowledgeRecords KnowledgeRecord[]

  @@index([state])
  @@index([lga])
  @@map("communities")
}

model KnowledgeRecord {
  id           String          @id @default(cuid())
  title        String
  content      String
  type         KnowledgeType
  status       KnowledgeStatus @default(DRAFT)
  embedding    Unsupported("vector(1536)")?
  sourceRank   Float           @default(0) @map("source_rank")
  upvotes      Int             @default(0)
  downvotes    Int             @default(0)
  createdById  String          @map("created_by")
  verifiedById String?         @map("verified_by")
  communityId  String?         @map("community_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  createdBy  User              @relation("CreatedBy", fields: [createdById], references: [id])
  verifiedBy User?             @relation("VerifiedBy", fields: [verifiedById], references: [id])
  community  Community?        @relation(fields: [communityId], references: [id])
  citations  Citation[]
  entities   KnowledgeEntity[]
  votes      Vote[]
  reports    Report[]

  @@index([status])
  @@index([type])
  @@index([communityId])
  @@index([sourceRank])
  @@map("knowledge_records")
}

model Vote {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  knowledgeRecordId String   @map("knowledge_record_id")
  type              VoteType
  createdAt         DateTime @default(now()) @map("created_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeRecord KnowledgeRecord @relation(fields: [knowledgeRecordId], references: [id], onDelete: Cascade)

  @@unique([userId, knowledgeRecordId])
  @@map("votes")
}

model Report {
  id                String       @id @default(cuid())
  userId            String       @map("user_id")
  knowledgeRecordId String       @map("knowledge_record_id")
  reason            String
  status            ReportStatus @default(OPEN)
  createdAt         DateTime     @default(now()) @map("created_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeRecord KnowledgeRecord @relation(fields: [knowledgeRecordId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model Entity {
  id          String     @id @default(cuid())
  name        String
  entityType  EntityType @map("entity_type")
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  knowledgeLinks KnowledgeEntity[]

  @@index([name])
  @@map("entities")
}

model KnowledgeEntity {
  id                String @id @default(cuid())
  knowledgeRecordId String @map("knowledge_record_id")
  entityId          String @map("entity_id")

  knowledgeRecord KnowledgeRecord @relation(fields: [knowledgeRecordId], references: [id], onDelete: Cascade)
  entity          Entity          @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([knowledgeRecordId, entityId])
  @@map("knowledge_entities")
}

model Document {
  id           String   @id @default(cuid())
  filename     String
  path         String
  mimeType     String   @map("mime_type")
  size         Int
  uploadedById String   @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  uploadedBy User       @relation(fields: [uploadedById], references: [id])
  citations  Citation[]

  @@map("documents")
}

model Citation {
  id                String  @id @default(cuid())
  knowledgeRecordId String  @map("knowledge_record_id")
  documentId        String  @map("document_id")
  page              Int?
  paragraph         String?

  knowledgeRecord KnowledgeRecord @relation(fields: [knowledgeRecordId], references: [id], onDelete: Cascade)
  document        Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("citations")
}

model Chat {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String   @default("New Chat")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@map("chats")
}

model Message {
  id        String      @id @default(cuid())
  chatId    String      @map("chat_id")
  role      MessageRole
  content   String
  createdAt DateTime    @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@map("messages")
}

model AudioUpload {
  id           String   @id @default(cuid())
  filename     String
  path         String
  mimeType     String   @map("mime_type")
  size         Int
  durationSec  Int?     @map("duration_sec")
  transcript   String?
  status       String   @default("PENDING") // PENDING | TRANSCRIBED | EXTRACTED | FAILED
  uploadedById String   @map("uploaded_by")
  communityId  String?  @map("community_id")
  createdAt    DateTime @default(now()) @map("created_at")

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@map("audio_uploads")
}
