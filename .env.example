# ---------- Required ----------
# Long random secret (>= 32 chars). Generate: openssl rand -hex 32
JWT_SECRET=
# Comma-separated admin usernames (case-insensitive), e.g. ADMIN_USERNAMES=chidi,ada
# Register with one of these usernames to become admin. Claim them right after deploy:
# whoever registers a listed username first gets admin.
ADMIN_USERNAMES=
# Database password. Change it before first deploy.
POSTGRES_PASSWORD=change-me


# ---------- AI (all optional) ----------
# Chat model via OpenAI-compatible API (RunPod: API key + base URL + model).
# Without these three, Ask returns verified excerpts directly (no model call).
RUNPOD_API_KEY=
RUNPOD_BASE_URL=
RUNPOD_MODEL=
# Optional legacy: RunPod serverless endpoint ID (only if you use /v2/{id}/runsync).
# RUNPOD_ENDPOINT_ID=
# Embeddings for semantic search. Without them, chat uses keyword search over verified records.
EMBEDDING_API_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Whisper speech-to-text for oral history uploads
OPENAI_API_KEY=

# ---------- Email (verification words + password reset) ----------
# MAIL_PROVIDER: resend | smtp | console. Leave empty to auto-pick: resend if RESEND_API_KEY is set,
# smtp if SMTP_HOST is set, otherwise console (the word is printed in the backend logs; nothing is sent).
# Signup works either way — unverified users just see a "confirm your email" reminder.
MAIL_PROVIDER=
# Sender shown in the inbox. With Resend this must be on a domain you verified there.
MAIL_FROM=Aphring <no-reply@your-domain.ng>
# Public URL of the site, used for the links inside emails (e.g. https://aphring.ng)
APP_URL=
# Resend (https://resend.com): create an API key, verify your sending domain.
RESEND_API_KEY=
# Any SMTP server (Zoho, Gmail app password, Mailgun, Brevo, Postmark…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465 (implicit TLS); leave empty for 587/STARTTLS
SMTP_SECURE=

# ---------- Optional ----------
# Only if browsers call the backend directly (normally /api is proxied by the frontend)
FRONTEND_URL=
# Local development only: deterministic fake vectors. Ignored when NODE_ENV=production.
# ALLOW_FAKE_EMBEDDINGS=true
# Log every SQL query (noisy; debugging only)
# PRISMA_LOG_QUERIES=true
