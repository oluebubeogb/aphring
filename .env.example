# Database
DATABASE_URL=postgresql://aphring:aphring_secret@postgres:5432/aphring?schema=public

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=aphring
MINIO_SECRET_KEY=aphring_minio_secret
MINIO_BUCKET=aphring-documents
MINIO_USE_SSL=false

# Auth
JWT_SECRET=change-me-to-a-long-random-string
NEXTAUTH_SECRET=change-me-to-another-long-random-string
NEXTAUTH_URL=https://your-domain.com

# Runpod Granite
RUNPOD_API_KEY=your_runpod_api_key
RUNPOD_ENDPOINT_ID=your_granite_endpoint_id

# Embeddings (OpenAI-compatible or local)
EMBEDDING_API_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=your_embedding_key
EMBEDDING_MODEL=text-embedding-3-small

# App
NODE_ENV=production
BACKEND_URL=http://backend:4000
FRONTEND_URL=https://your-domain.com
PORT=4000

# Coolify / Public
NEXT_PUBLIC_API_URL=https://api.your-domain.com
